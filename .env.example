# Optional for public endpoints; required for matching, price history, and usage.
PRIJSPROFEET_API_KEY=

# Usually leave these defaults unchanged.
PRIJSPROFEET_BASE_URL=https://www.prijsprofeet.nl
PRIJSPROFEET_TIMEOUT_MS=15000

# Identify your application per the PriceProfeet API guidance.
# Do not use bot, crawler, spider, or slurp without an API key.
PRIJSPROFEET_USER_AGENT=PrijsProfeetMCP/1.0 (+https://github.com/thijserven/prijsprofeet-mcp)
